# FalkorDB Connection Settings
# FalkorDB Cloud: host from app.falkordb.cloud (e.g. r-xyz.falkordb.cloud)
# Local Docker: host=localhost, port=6379, password=""
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=

# Primary Graph Names (Multigraph Topology)
FALKORDB_COMPANY_GRAPH=nexus_company_brain
FALKORDB_INCIDENTS_GRAPH=nexus_incident_memory

# App Server Settings
PORT=8000
HOST=0.0.0.0
